# Copy this file to .env in this directory. Vite only exposes variables prefixed with VITE_.

# Go REST API.
VITE_API_BASE_URL=http://localhost:8080

# AppSync GraphQL HTTP endpoint, including /graphql.
VITE_APPSYNC_GRAPHQL_URL=https://xxxxxxxx.appsync-api.ap-southeast-1.amazonaws.com/graphql

# Realtime endpoint: same API id and region, appsync-realtime-api host, path /graphql.
VITE_APPSYNC_REALTIME_URL=wss://xxxxxxxx.appsync-realtime-api.ap-southeast-1.amazonaws.com/graphql

# GraphQL HTTP host with no scheme and no path. Sent as the WebSocket `host` header.
VITE_APPSYNC_HOST=xxxxxxxx.appsync-api.ap-southeast-1.amazonaws.com
